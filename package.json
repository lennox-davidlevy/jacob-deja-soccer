{
  "name": "jacob-deja-soccer",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:placeholders": "bun run scripts/generate-placeholders.ts",
    "assets:portrait": "magick media/pic_1.jpeg -gravity center -crop 4:5 -resize 720x900 -strip -modulate 90,72,100 -level 6%,94% -fill '#0A2019' -colorize 8% -attenuate 0.04 +noise Gaussian -quality 82 src/assets/jacob-portrait.webp && magick src/assets/jacob-portrait.webp -quality 84 public/jacob-portrait.jpg",
    "assets:onepager": "bun run scripts/generate-onepager.ts",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@fontsource/anton": "latest",
    "@fontsource/geist-mono": "latest",
    "@fontsource/inter": "latest",
    "@gsap/react": "latest",
    "astro": "^5.16.0",
    "gsap": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.0"
  }
}
