---
import Base from "../layout/Base.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Film from "../components/Film.astro";
import Hero from "../components/Hero.astro";
import NavDots from "../components/NavDots.astro";
import Schedule from "../components/Schedule.astro";
import ScrubStage from "../components/ScrubStage";
import Vitals from "../components/Vitals.astro";
import { loadSiteContent } from "../lib/content";

const content = await loadSiteContent();
const filmLink = content.links.find(({ label }) => /film|reel|highlight/i.test(label));
const contactLinks = content.links.filter((link) => link !== filmLink);
const about = content.bio?.find(({ key }) => key === "about")?.value;
---

<Base
  title="Jacob Deja · CAM · Class of 2027 — Recruiting"
  description="Jacob Deja · CAM/CDM · Class of 2027."
>
  <main>
    <Hero />
    <NavDots />
    <ScrubStage client:idle />
    <Vitals bio={content.bio} />
    <Film film={filmLink} />
    <Schedule fixtures={content.schedule} />
    <About about={about} />
    <Contact links={contactLinks} />
  </main>
</Base>
