---
import type { BioItem } from "../lib/content";

interface Props {
  bio?: BioItem[] | null;
}

const { bio = null } = Astro.props;
const fallbackVitals = [
  { key: "class", label: "Class", value: "2027" },
  { key: "position", label: "Position", value: "CAM / CDM" },
  { key: "foot", label: "Foot", value: "Right" },
  { key: "height", label: "Height", value: "5'10\"" },
  { key: "club", label: "Club", value: "The Island FC West", detail: "MLS Next HG" },
  { key: "high_school", label: "High school", value: "Comsewogue High School" },
  { key: "gpa", label: "GPA", value: "4.0" },
];
const vitals = bio === null ? fallbackVitals : bio.filter(({ key }) => key !== "about");
---

<section class="section content-section vitals" id="vitals" aria-labelledby="vitals-title">
  <div class="section-heading">
    <p class="eyebrow">Box score</p>
    <h2 id="vitals-title">Vitals</h2>
  </div>
  <dl class="vitals-grid">
    {vitals.map(({ key, label, value, detail }) => (
      <div class:list={["vital", key === "gpa" && "vital--featured"]}>
        <dt>{label}</dt>
        <dd>{value}{detail && <small>{detail}</small>}</dd>
      </div>
    ))}
  </dl>
</section>
